{
  "name": "entangleops-console",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "cross-env VITE_DEMO_MODE=true vite",
    "dev:fixtures": "cross-env VITE_DEMO_MODE=true VITE_DEMO_FIXTURES=true vite",
    "build": "tsc -b && vite build",
    "build:demo": "cross-env VITE_DEMO_MODE=true tsc -b && cross-env VITE_DEMO_MODE=true vite build",
    "build:fixtures": "cross-env VITE_DEMO_MODE=true VITE_DEMO_FIXTURES=true tsc -b && cross-env VITE_DEMO_MODE=true VITE_DEMO_FIXTURES=true vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "capture-fixtures": "tsx scripts/capture-fixtures.ts",
    "contract": "tsx scripts/contract-check.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.66.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.1",
    "msw": "^2.7.0",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^5.4.14",
    "vitest": "^2.1.8"
  }
}
