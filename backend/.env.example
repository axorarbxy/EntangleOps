EO_DATA_DIR=./data
EO_MODEL_PATH=./data/predictor.joblib
EO_DEFAULT_SEED=42
EO_DEFAULT_DT_S=60
EO_DEFAULT_DURATION_H=24
EO_FORECAST_HORIZON_STEPS=5
EO_SAFETY_MARGIN=0.01
EO_K_PATHS=4
EO_ENABLE_SEQUENCE=false
EO_CORS_ORIGINS=["*"]
# Generate each secret independently with: python -c "import secrets; print(secrets.token_hex(32))"
EO_ENV=development
EO_API_KEY_PEPPER=
EO_MODEL_SIGNING_KEY=
EO_KEYS_PATH=./data/keys.json
EO_AUDIT_PATH=./data/audit.jsonl
EO_ENABLE_DOCS=true
EO_BEHIND_TLS=false
EO_TRUSTED_PROXY_COUNT=0
EO_MAX_BODY_BYTES=65536
EO_WS_TICKET_TTL_S=30
EO_WS_ALLOWED_ORIGINS=[]
EO_RATE_PER_KEY_PER_MIN=120
EO_RATE_PER_IP_PER_MIN=240
EO_RATE_AUTH_FAIL_PER_IP_PER_MIN=10
EO_MAX_CONCURRENT_RUNS=2
EO_MAX_QUEUED_RUNS=10
EO_MAX_RUNS_PER_KEY_ACTIVE=3
EO_MAX_STORED_RUNS=200
EO_RUN_TIMEOUT_S=120
EO_MAX_WS_PER_KEY=3
EO_MAX_STEPS_PER_RUN=5760
EO_MAX_EXPECTED_REQUESTS_PER_RUN=20000
EO_METRICS_ENABLED=true
# Generate with: python scripts/gen_monitoring_secrets.py
EO_METRICS_TOKEN=
EO_LOG_LEVEL=INFO
EO_LOG_JSON=true
EO_SLOW_REQUEST_S=2.0
EO_DRIFT_SAMPLE_EVERY_STEPS=10
EO_DRIFT_EWMA_ALPHA=0.05
EO_AUDIT_VERIFY_INTERVAL_S=300
EO_LOOP_LAG_INTERVAL_S=0.5
# Compose interpolation uses this in addition to the EO settings above.
GRAFANA_ADMIN_PASSWORD=
